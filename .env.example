# Copy to .env.local for local development. Never commit real values.
# Variables are added here as each phase needs them (docs/rewrite-plan.md §5).

# Public URL of the sales site. Optional: Vercel URLs are used when unset.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public URL of the app (requirements §15.4, APP-12). Set it to the app's own
# origin, such as https://app.mintly.uk, to serve the app from that host. Leave
# it unset (previews, local) to serve the app at /app on the same host.
# For local hostname routing use http://app.localhost:3000 and set
# NEXT_PUBLIC_SITE_URL=http://www.localhost:3000.
# NEXT_PUBLIC_APP_URL=

# Domain for the non-sensitive "signed in" hint cookie (APP-06), so the sales
# site can show "Open app". Set to .mintly.uk in staging and production.
# SIGNED_IN_HINT_COOKIE_DOMAIN=

# Set to "true" on production only, at cut-over, to allow search indexing.
# SITE_INDEXABLE=

# --- Supabase (phase 1) ---
# Dashboard → Project Settings → API. The publishable key is safe in the
# browser; RLS decides what it can read. (Older projects call it the anon key,
# and NEXT_PUBLIC_SUPABASE_ANON_KEY is accepted instead.)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Only for `npm run db:push` and `npm run db:migrations`, never used by the
# app: the database connection string from Dashboard → Connect → Session
# pooler, with your database password in it. Percent-encode special
# characters in the password.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-eu-west-2.pooler.supabase.com:5432/postgres
