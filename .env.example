# Copy to .env.local for local development. Never commit real values.
# Variables are added here as each phase needs them (docs/rewrite-plan.md §5).

# Public URL of the site. Optional: Vercel URLs are used when unset.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to "true" on production only, at cut-over, to allow search indexing.
# SITE_INDEXABLE=
