# Copy to .env.local for local development. Never commit real values.
# Variables are added here as each phase needs them (docs/rewrite-plan.md §5).

# Public URL of the sales site. Optional: Vercel URLs are used when unset.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public URL of the app (requirements §15.4, APP-12). Set it to the app's own
# origin, such as https://app.mintly.uk, to serve the app from that host. Leave
# it unset (previews, local) to serve the app at /app on the same host.
# For local hostname routing use http://app.localhost:3000 and set
# NEXT_PUBLIC_SITE_URL=http://www.localhost:3000.
# NEXT_PUBLIC_APP_URL=

# Domain for the non-sensitive "signed in" hint cookie (APP-06), so the sales
# site can show "Open app". Set to .mintly.uk in staging and production.
# SIGNED_IN_HINT_COOKIE_DOMAIN=

# Set to "true" on production only, at cut-over, to allow search indexing.
# SITE_INDEXABLE=

# --- Supabase (phase 1) ---
# Dashboard → Project Settings → API. The publishable key is safe in the
# browser; RLS decides what it can read. (Older projects call it the anon key,
# and NEXT_PUBLIC_SUPABASE_ANON_KEY is accepted instead.)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Only for `npm run db:push` and `npm run db:migrations`, never used by the
# app: the database connection string from Dashboard → Connect → Session
# pooler, with your database password in it. Percent-encode special
# characters in the password.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-eu-west-2.pooler.supabase.com:5432/postgres

# The secret (service role) key, for server code only: the Stripe webhook,
# provisioning and admin actions. Never expose it to the browser. Dashboard →
# Project Settings → API keys. (Older projects call it the service role key,
# and SUPABASE_SERVICE_ROLE_KEY is accepted instead.)
SUPABASE_SECRET_KEY=sb_secret_...

# Optional: signs admins' view-as sessions (ADM-13). Without it, a key is
# derived from SUPABASE_SECRET_KEY. Changing it ends every view-as session.
# VIEW_AS_SECRET=

# --- Stripe (phase 2) ---
# The new app's own Stripe sandbox, never the old site's test mode (plan
# §10.4). Live keys are refused outside production. See docs/stripe-setup.md.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- AWS (phase 2) ---
# The IAM role Vercel OIDC assumes (plan §7). Leave unset to use the
# in-memory fake API Gateway, which logs key actions and refuses production.
# AWS_ROLE_ARN=arn:aws:iam::<account>:role/mintly-web-staging
# AWS_REGION=eu-west-2

# --- Email (phase 2) ---
# Resend (Q7). Without a key, emails are logged instead of sent.
# RESEND_API_KEY=re_...
# EMAIL_FROM=Mintly <no-reply@mintly.uk>
# Where new-customer and new-user notices go (PROV-02, AUTH-07).
# ADMIN_NOTIFY_EMAIL=info@mintly.uk

# --- Brevo (phase 2) ---
# The marketing list (Q7). Without both, Brevo calls are skipped.
# BREVO_API_KEY=xkeysib-...
# BREVO_LIST_ID=

# --- Trial review and scheduled jobs (phase 2b) ---
# Vercel Cron sends this as a bearer token to /api/cron/* (plan §8). Set it
# in Vercel; without it the cron routes refuse every request.
# CRON_SECRET=
# Key for hashing sign-up IP addresses (plan §9: IPs are hashed). Any long
# random string; keep it stable, or repeat-trial matching by IP resets.
# Required on production; elsewhere a fixed development key is used.
# IP_HASH_SECRET=

# Development and tests only: send Stripe requests to a local mock API
# instead, such as http://localhost:12111. Ignored on production.
# STRIPE_API_URL=

# --- Tools and usage (phase 3) ---
# The Mintly-held sandbox key the Tools page uses while a trial awaits
# review (APPR-03). Without it, development and previews answer like the
# sandbox from a built-in fake; production refuses sandbox checks.
# SANDBOX_API_KEY=
# Development and staging only: the API the Tools proxy calls with an
# organisation's key, such as https://sandbox.mintly.uk/bankAccount/v1 on
# staging, whose keys live in test usage plans (plan §10.4). Ignored on
# production, which always calls https://api.mintly.uk/bankAccount/v1.
# Without AWS_ROLE_ARN and this, a built-in fake answers like the sandbox.
# BANK_API_URL=
# The DynamoDB table the nightly usage sync reads (plan §6.4). The IAM role
# in AWS_ROLE_ARN also needs dynamodb:Query on it (plan §7).
# USAGE_STATS_TABLE=ApiDailyUsageStats

# --- Teams and SSO (phase 4) ---
# Google reCAPTCHA v3 for the SSO look-up on the sign-in page (SSO-02), and
# in phase 6 the free checker and enquiry form. Register the app and sales
# hosts at https://www.google.com/recaptcha/admin. Without the secret the
# check is skipped, except on production, which refuses SSO look-ups, free
# checks, enquiries, ratings and the email capture (phase 6).
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# RECAPTCHA_SECRET_KEY=

# --- Marketing site (phase 6) ---
# The free sort code checker's API key (FREE-05), held on the server only.
# The old site's key was in source: rotate it and set the new one here.
# Without it, development and previews answer from a built-in fake;
# production refuses free checks.
# FREE_CHECKER_API_KEY=
# The Brevo list for the BACS checklist download on /links (LEAD-02).
# BREVO_LEAD_LIST_ID=9
# Analytics and marketing, each loaded only after cookie consent (WEB-06).
# Leave any unset to turn it off.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_GOOGLE_ADS_ID=AW-XXXXXXXXX
# NEXT_PUBLIC_GOOGLE_ADS_CONVERSION=AW-XXXXXXXXX/label
# NEXT_PUBLIC_META_PIXEL_ID=
# NEXT_PUBLIC_CLARITY_ID=
# Tawk.to live chat, as "propertyId/widgetId". Loads without consent, as
# the chat is something visitors ask for; hidden on the API docs.
# NEXT_PUBLIC_TAWK_CHAT=
